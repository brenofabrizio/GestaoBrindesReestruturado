DJANGO_SECRET_KEY=change-me-in-development
DJANGO_DEBUG=1
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# On Vercel, prefer the DATABASE_URL supplied by Vercel Postgres/Neon.
# DATABASE_URL=postgresql://user:password@host:5432/database?sslmode=require

# PostgreSQL is the persistent database for deployed environments.
POSTGRES_DB=gestaobrindes
POSTGRES_USER=gestaobrindes
POSTGRES_PASSWORD=gestaobrindes
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

CORS_ALLOWED_ORIGINS=http://localhost:5173
CSRF_TRUSTED_ORIGINS=https://*.vercel.app
